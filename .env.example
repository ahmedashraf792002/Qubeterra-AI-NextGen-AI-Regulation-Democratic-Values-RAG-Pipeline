# ==============================================================
# Qubeterra AI NextGen — RAG Pipeline Configuration
# ==============================================================

# --------------------------------------------------------------
# PostgreSQL connection (Storage & Retrieval stages)
# --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai_reg_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# --------------------------------------------------------------
# Collection stage (src/collection/data_collection.py)
# --------------------------------------------------------------
MAX_DOCUMENTS=60
CRAWL_DEPTH=1
REQUEST_TIMEOUT=20
REQUEST_DELAY=0.5
MIN_ACCEPTABLE_CHARS=200
MIN_QUALITY_CHARS=500
DOCUMENT_NAME_PREFIX=document_
DOCUMENT_NAME_DIGITS=2

# --------------------------------------------------------------
# Preprocessing / Cleaning stage (src/preprocessing/clean_documents.py)
# --------------------------------------------------------------
SPOT_CHECK_SAMPLE_SIZE=5
SPOT_CHECK_SNIPPET_CHARS=600
BOILERPLATE_LINE_FREQUENCY_THRESHOLD=0.25
BOILERPLATE_MAX_LINE_LENGTH=120

# --------------------------------------------------------------
# Chunking stage (src/chunking/chunk_documents.py)
# --------------------------------------------------------------
MAX_CHUNK_TOKENS_SAFETY_CAP=600
CHARS_PER_TOKEN_APPROX=4
MIN_CHUNK_CHARS=200

# --------------------------------------------------------------
# Embedding stage (src/embeddings/generate_embeddings.py)
# --------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONALITY=384
MODEL_MAX_TOKENS=512
ENCODE_BATCH_SIZE=32

# --------------------------------------------------------------
# Retrieval stage (src/retrieval/retrieve.py)
# --------------------------------------------------------------
DEFAULT_TOP_K=5
EVAL_TOP_K=5

# ==============================================================
# Week 2 — LLM Provider (Agent Framework)
# ==============================================================
# Choose one: openrouter | gemini | ollama | grok
# ==============================================================

LLM_PROVIDER=openrouter

# --- OpenRouter ---
# Get key: https://openrouter.ai/keys
# Models: openai/gpt-4o-mini, anthropic/claude-3-haiku, meta-llama/llama-3-8b-instruct
# OPENROUTER_API_KEY=your_key_here

# --- Google Gemini ---
# Get key: https://aistudio.google.com/apikey
# Models: gemini-2.0-flash, gemini-1.5-pro
# GEMINI_API_KEY=your_key_here

# --- Ollama (Local) ---
# Install: https://ollama.com
# Models: llama3, mistral, phi3, codellama
# No API key needed

# --- Grok (xAI) ---
# Get key: https://console.x.ai
# Models: grok-2, grok-2-mini
# GROK_API_KEY=your_key_here

# ==============================================================
# Active LLM Configuration
# ==============================================================

# API key (set for the provider you chose above)
LLM_API_KEY=your_api_key_here

# Base URL (auto-set by provider, or override manually)
# OpenRouter:  https://openrouter.ai/api/v1
# Gemini:      https://generativelanguage.googleapis.com/v1beta
# Ollama:      http://localhost:11434/v1
# Grok:        https://api.x.ai/v1
LLM_BASE_URL=

# Model name (auto-set by provider, or override manually)
LLM_MODEL=

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7

# Max tokens per response
LLM_MAX_TOKENS=2048
